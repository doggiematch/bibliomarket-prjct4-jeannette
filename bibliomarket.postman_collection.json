{
  "info": {
    "name": "Bibliomarket API",
    "description": "Coleccion de Postman para probar y documentar Bibliomarket. Sirve para comprobar las acciones principales de la aplicacion: crear una cuenta, iniciar sesion, ver libros, publicar libros, reservarlos, marcarlos como favoritos y buscar datos en Open Library.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('La respuesta no es un error del servidor', function () {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});",
          "",
          "pm.test('La respuesta tarda menos de 3 segundos', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(3000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "description": "Direccion donde se esta ejecutando el backend en local."
    },
    {
      "key": "token",
      "value": "",
      "description": "Se rellena automaticamente al hacer login correctamente."
    },
    {
      "key": "bookId",
      "value": "1",
      "description": "Identificador de un libro existente para probar detalle, edicion, reserva o favorito."
    },
    {
      "key": "reservationId",
      "value": "1",
      "description": "Identificador de una reserva existente para probar su eliminacion."
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Sirve para comprobar si el servidor esta encendido.",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El servidor responde correctamente', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "description": "Comprueba que el backend esta funcionando antes de probar el resto de peticiones.",
            "method": "GET",
            "url": "{{baseUrl}}/"
          },
          "response": [
            {
              "name": "Servidor encendido",
              "originalRequest": {
                "method": "GET",
                "url": "{{baseUrl}}/"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"Bibliomarket API running\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Peticiones relacionadas con crear una cuenta e iniciar sesion.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El registro devuelve una respuesta correcta', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('La respuesta trae usuario y token', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('user');",
                  "  pm.expect(json).to.have.property('token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "description": "Crea una cuenta nueva. Si el correo ya existe, hay que cambiarlo por otro.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tu Nombre\",\n  \"email\": \"tuemail@ejemplo.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "response": [
            {
              "name": "Usuario creado",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Tu Nombre\",\n  \"email\": \"tuemail@ejemplo.com\",\n  \"password\": \"123456\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/register"
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Tu Nombre\",\n    \"email\": \"tuemail@ejemplo.com\",\n    \"role\": \"USER\"\n  },\n  \"token\": \"token_de_ejemplo\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El login responde correctamente', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Guarda el token para las siguientes peticiones', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('token');",
                  "  pm.collectionVariables.set('token', json.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "description": "Inicia sesion con un usuario de prueba y guarda el token para poder usar las peticiones protegidas.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos@example.com\",\n  \"password\": \"user123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": [
            {
              "name": "Login correcto",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"carlos@example.com\",\n  \"password\": \"user123\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/login"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Carlos\",\n    \"email\": \"carlos@example.com\",\n    \"role\": \"USER\"\n  },\n  \"token\": \"token_de_ejemplo\"\n}"
            }
          ]
        }
      ]
    },
