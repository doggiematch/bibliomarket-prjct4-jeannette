            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tuemail@ejemplo.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "http://localhost:3000/api/auth/login"
          }
        }
      ]
    }
